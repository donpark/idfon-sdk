# Serve defaults for `pnpm agent start monitor` (applied only when unset).
# The monitor is a plain filer on a mock model (docs/diag.md): no AI gateway
# key, and the holder is the plain eve-idfon runner without gpt-live.
EVE_IDFON_MODEL=monitor
EVE_IDFON_PKG=eve-idfon
EVE_IDFON_BIN=eve-idfon
EVE_IDFON_FEATURES=
