# Serve defaults for `pnpm agent start feedback` (applied only when unset).
# Deterministic, like the monitor: a mock model (no AI gateway key) and the
# plain eve-idfon runner without gpt-live. Empty EVE_IDFON_MODEL keeps the
# agent's own model and skips the rebuild-on-model-change check.
EVE_IDFON_MODEL=
EVE_IDFON_PKG=eve-idfon
EVE_IDFON_BIN=eve-idfon
EVE_IDFON_FEATURES=
