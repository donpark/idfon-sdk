{
  "name": "@idfon/sdk",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "clean": "bash ./scripts/build.sh clean",
    "cli": "pnpm --filter @idfon/cli",
    "eve": "bash ./scripts/eve.sh",
    "voice": "bash ./scripts/voice.sh",
    "pair": "bash ./scripts/pair-apple-channels.sh",
    "test-contacts": "bash ./scripts/test-contacts.sh",
    "agent": "bash ./scripts/agent.sh",
    "idfon": "node cli/idfon/bin/idfon.js",
    "all": "pnpm --filter \"./agents/*\" --filter \"./integrations/*\" --filter ./cli",
    "clean:build-cache": "rm -rf ../idfon-core/target ~/.cargo/registry/src"
  },
